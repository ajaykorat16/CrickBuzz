{
  "name": "crickbuzz",
  "version": "1.0.0",
  "description": "Cricket tournament REST API — auth and users",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "knex --knexfile config/database.js migrate:latest",
    "migrate:rollback": "knex --knexfile config/database.js migrate:rollback",
    "migrate:make": "knex --knexfile config/database.js migrate:make"
  },
  "keywords": [
    "cricket",
    "express",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "moment": "^2.30.1",
    "mysql2": "^3.23.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
