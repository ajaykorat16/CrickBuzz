NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=crickbuzz

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Short-lived token issued after OTP verify when profile is incomplete
JWT_PROFILE_EXPIRES_IN=15m

# When true, OTP is logged and returned in send-otp response (local/dev only)
OTP_DEV_MODE=true
OTP_EXPIRY_MINUTES=5
